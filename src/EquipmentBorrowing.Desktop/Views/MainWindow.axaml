<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:views="using:EquipmentBorrowing.Desktop.Views"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="800" Height="500"
        Background="{StaticResource ColorBackground}">
  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0" Background="{StaticResource ColorAccent}">
      <StackPanel Spacing="8" Margin="12">
        <TextBlock Text="Campus Equipment Borrowing System" FontWeight="Bold" TextWrapping="Wrap"/>
        <Button Content="Equipment" Command="{Binding ShowEquipmentCommand}" HorizontalAlignment="Stretch"/>
        <Button Content="Active Borrowings" Command="{Binding ShowBorrowingsCommand}" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentView}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:EquipmentViewModel">
          <views:EquipmentView/>
        </DataTemplate>
        <DataTemplate DataType="vm:BorrowingsViewModel">
          <views:BorrowingsView/>
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </Grid>
</Window>