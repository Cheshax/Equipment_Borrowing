<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock Grid.Row="0" Classes="heading" Text="Available Equipment"/>

    <ListBox Grid.Row="1"
             ItemsSource="{Binding ActiveBorrowings}"
             SelectedItem="{Binding SelectedBorrowing}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Id}" Width="60"/>
            <TextBlock Text="{Binding StudentId}" Width="80"/>
            <TextBlock Text="{Binding EquipmentId}" Width="80"/>
            <TextBlock Text="{Binding ExpectedReturnDate}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
      <Button Content="Return Equipment" Command="{Binding ReturnCommand}"/>
      <TextBlock Text="{Binding StatusMessage}" Foreground="DarkRed"/>
    </StackPanel>
  </Grid>
</UserControl>